# Groq Primary LLM Settings
LLM_PROVIDER=groq
LLM_MODEL_ID=qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Secondary / Fallback Providers
GOOGLE_API_KEY=
GEMINI_API_KEY=
LLM_FALLBACK_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=

# LLM Runtime Controls
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0.1
REAL_LLM=0

# FalkorDB & Persistence
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
SQLITE_DB_PATH=opsmemory.db
ENABLE_EMBEDDINGS=false

# Auth & Admin
ADMIN_API_KEY=test_admin_secret

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
