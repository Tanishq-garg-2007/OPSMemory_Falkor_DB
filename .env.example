# Groq Primary LLM Settings
LLM_PROVIDER=groq
LLM_MODEL_ID=qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Secondary / Fallback Providers
GOOGLE_API_KEY=
GEMINI_API_KEY=
LLM_FALLBACK_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=

# LLM Runtime Controls
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.1
# Must be 1 to use Groq/Google. 0 = offline Mock LLM (deterministic, for tests).
REAL_LLM=1

# FalkorDB & Persistence
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
ENABLE_EMBEDDINGS=true

# Auth & Admin
ADMIN_API_KEY=change_me_to_a_long_random_string

# Server
DEBUG=false
